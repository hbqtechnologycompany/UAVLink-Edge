# DroneBridge Docker — copy: cp .env.example .env

# Thư mục dữ liệu trên host (bind-mount vào /opt/dronebridge trong container)
DRONEBRIDGE_DIR=/opt/dronebridge

TZ=Asia/Ho_Chi_Minh

# --- Optional: profile bootstrap (docker compose --profile bootstrap up -d) ---
HOST_REPO_PATH=/home/cm5drone6425/HBQ_FlighControl/QCC-CloudControlStation/Pi_CM5_DroneBridgeService
REPO_URL=
REPO_BRANCH=main
DRONE_RUN_USER=cm5drone6425
PULL_INTERVAL=300
HEALTH_INTERVAL=60
MAX_INSTALL_RETRIES=3
DRONEBRIDGE_AUTO_REBOOT=1
